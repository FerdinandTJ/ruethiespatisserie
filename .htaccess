# Ruethies Patisserie — Hostinger (Apache/LiteSpeed)
<IfModule mod_rewrite.c>
RewriteEngine On
# Staging hanya diakses lewat subdomain, bukan URL /staging pada domain produksi.
RewriteCond %{HTTP_HOST} !^staging\.ruethiespatisserie\.com(?::[0-9]+)?$ [NC]
RewriteCond %{THE_REQUEST} \s/+staging(?:[/\s?]) [NC]
RewriteRule ^ - [F,L]
# Kanonis: https://ruethiespatisserie.com/ (tanpa www) — satu redirect 301, tanpa rantai
RewriteCond %{HTTP_HOST} ^www\.ruethiespatisserie\.com$ [NC]
RewriteRule ^ https://ruethiespatisserie.com%{REQUEST_URI} [L,R=301]
# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Jangan indeks subdomain staging (password akses tetap dipasang lewat hPanel).
<IfModule mod_setenvif.c>
SetEnvIfNoCase Host "^staging\.ruethiespatisserie\.com(:[0-9]+)?$" RUETHIES_NOINDEX=1
</IfModule>
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=RUETHIES_NOINDEX
</IfModule>

# Compress
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Cache: aset versi (query ?v=) 30 hari; HTML 10 menit; JSON selalu revalidasi (menu instan)
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 10 minutes"
ExpiresByType text/css "access plus 30 days"
ExpiresByType application/javascript "access plus 30 days"
ExpiresByType text/javascript "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
Header set X-Frame-Options "SAMEORIGIN"
# HSTS 6 bulan (aktifkan setelah HTTPS stabil; tanpa preload)
Header set Strict-Transport-Security "max-age=15552000"
# CSP: hanya sumber yang dipakai web ini
Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data:; connect-src 'self'; frame-src https://www.google.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# Aset CSS/JS memakai versi URL; JSON admin tetap wajib revalidasi.
<FilesMatch "\.(css|js)$">
<IfModule mod_headers.c>
Header set Cache-Control "public, max-age=2592000"
</IfModule>
</FilesMatch>

# Matikan directory listing
<IfModule mod_autoindex.c>
Options -Indexes
</IfModule>

# Blok akses .git dan file sensitif nyasar (env/sql/bak/log/zip/old)
<IfModule mod_rewrite.c>
RewriteRule ^\.git - [F,L]
</IfModule>
<FilesMatch "\.(env|sql|bak|log|zip|old|swp)$">
Require all denied
</FilesMatch>

# Data JSON (menu/galeri): JANGAN disimpan — browser wajib tanya versi baru tiap buka web.
# Server menjawab 304 mungil bila tak berubah. Inilah yang membuat update admin instan.
<FilesMatch "\.json$">
<IfModule mod_headers.c>
Header set Cache-Control "no-cache, must-revalidate"
Header unset Expires
</IfModule>
</FilesMatch>

ErrorDocument 404 /404.html

# Keamanan dasar: block akses dotfiles
<FilesMatch "^\.">
Require all denied
</FilesMatch>
