# Ruethies Patisserie — Hostinger (Apache/LiteSpeed)
<IfModule mod_rewrite.c>
RewriteEngine On
# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Compress
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Cache statis 30 hari (HTML jangan di-cache lama, menu.json pendek agar update cepat tayang)
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 1 hour"
ExpiresByType text/css "access plus 30 days"
ExpiresByType application/javascript "access plus 30 days"
ExpiresByType application/json "access plus 5 minutes"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-downgrade"
Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

# Data JSON tayang instan: revalidasi tiap 5 menit
<FilesMatch "\.json$">
<IfModule mod_headers.c>
Header set Cache-Control "public, max-age=300, must-revalidate"
</IfModule>
</FilesMatch>

ErrorDocument 404 /404.html

# Keamanan dasar: block akses dotfiles
<FilesMatch "^\.">
Require all denied
</FilesMatch>
